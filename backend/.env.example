# Clave secreta para firmar los tokens JWT (en producción usa una cadena larga y aleatoria)
SECRET_KEY=cambia_esta_clave_secreta_en_produccion

# Orígenes permitidos por CORS (separados por coma, sin barra / al final)
# Ejemplo: ALLOWED_ORIGINS=http://localhost:5173,https://farma-en-casa.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# URL de conexión a la base de datos (por defecto usa SQLite local si se omite)
# DATABASE_URL=postgresql://usuario:password@host:5432/nombre_bd
