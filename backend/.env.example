# Clave secreta para firmar los tokens JWT (en producción usa una cadena larga y aleatoria)
SECRET_KEY=cambia_esta_clave_secreta_en_produccion

# Orígenes permitidos por CORS (separados por coma, sin barra / al final)
# Ejemplo: ALLOWED_ORIGINS=http://localhost:5173,https://farma-en-casa.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# URL de conexión a la base de datos (por defecto usa SQLite local si se omite)
# DATABASE_URL=postgresql://usuario:password@host:5432/nombre_bd

# ==========================================================
# ENVÍO DE CORREOS PARA CÓDIGO DE CONFIRMACIÓN (OTP)
# Configura UNA de las siguientes opciones (todas gratuitas):
# ==========================================================

# Opción 1 (Recomendada en Render Free — usa HTTPS puerto 443, 300 correos/día gratis sin tarjeta):
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM=tu_correo_verificado@gmail.com
# MAIL_FROM_NAME=FarmaEnCasa

# Opción 2 (Resend API — HTTPS puerto 443):
# RESEND_API_KEY=re_...
# MAIL_FROM=onboarding@resend.dev

# Opción 3 (Gmail SMTP con Contraseña de Aplicación — ideal en local):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASSWORD=tu_contrasena_de_aplicacion_16_caracteres
# MAIL_FROM=tu_correo@gmail.com
